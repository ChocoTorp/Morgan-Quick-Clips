{
  "name": "simpleclips",
  "version": "0.1.0",
  "description": "Turn screen recordings and videos into short, polished clips. Cross-platform (Windows + macOS).",
  "main": "src/main/index.js",
  "author": "Morgan",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "engine": "node tools/engine-cli.js",
    "test": "node tools/engine-test.js",
    "icon": "node scripts/make-icon.mjs",
    "fetch:whisper": "node scripts/fetch-whisper.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.morgan.simpleclips",
    "productName": "SimpleClips",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.swift",
      "!**/*.sh",
      "!Resources${/*}",
      "!scripts${/*}"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/win/bin",
          "to": "bin"
        },
        {
          "from": "models",
          "to": "models"
        },
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SimpleClips"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "resources/mac/bin",
          "to": "bin"
        },
        {
          "from": "models",
          "to": "models"
        }
      ]
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
