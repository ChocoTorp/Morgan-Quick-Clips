# ===== macOS Swift app (mac/) =====
mac/build/
*.app
# models are large; the mac app fetches to $HOME (see mac/scripts/fetch-model.sh)
*.bin

# macOS cruft
.DS_Store

# ===== Windows / Electron app (windows/) =====
windows/node_modules/
windows/dist/
windows/resources/win/bin/
windows/resources/mac/bin/
windows/models/
windows/build/*
!windows/build/icon*

# ===== Downloadable build artifacts (too large for git; distribute via Releases) =====
# Keep the per-platform README placeholders, ignore the actual binaries.
# NOTE: folder is "Downloadable builds" (capital D) — match it exactly for case-sensitive
# git hosts like GitHub.
Downloadable builds/**/*.exe
Downloadable builds/**/*.dmg
Downloadable builds/**/*.zip
Downloadable builds/**/*.app/
